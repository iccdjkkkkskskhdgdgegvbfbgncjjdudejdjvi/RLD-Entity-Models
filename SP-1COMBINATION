local function getRandomHorizontalDirection()
	local angle = math.random() * math.pi * 2

	return Vector3.new(
		math.cos(angle),
		0,
		math.sin(angle)
	).Unit
end

local function startFinalChaserFlight()
	if destroyed
		or not orbitFinalPart
		or not orbitFinalPart.Parent then
		return
	end

	if orbitFinalFlightConnection then
		orbitFinalFlightConnection:Disconnect()
		orbitFinalFlightConnection = nil
	end

	orbitFinalFlying = true

	orbitFinalVelocity =
		getRandomHorizontalDirection() * 20

	local rayParams = RaycastParams.new()

	rayParams.FilterType =
		Enum.RaycastFilterType.Exclude

	rayParams.IgnoreWater = true

	orbitFinalFlightConnection =
		RunService.RenderStepped:Connect(function(dt)

			if destroyed
				or not orbitFinalFlying
				or not orbitFinalPart
				or not orbitFinalPart.Parent then

				if orbitFinalFlightConnection then
					orbitFinalFlightConnection:Disconnect()
					orbitFinalFlightConnection = nil
				end

				return
			end

			-- Model của entity không được tính là vật cản,
			-- nhưng LocalPlayer vẫn được tính.
			rayParams.FilterDescendantsInstances = {
				model,
				orbitFinalPart
			}

			local movement =
				orbitFinalVelocity * dt

			local result = workspace:Raycast(
				orbitFinalPart.Position,
				movement,
				rayParams
			)

			if result then
				local hitPosition = result.Position
				local normal = result.Normal

				-- Đặt part sát bề mặt vật cản/player
				orbitFinalPart.Position =
					hitPosition +
					normal * 0.1

				-- Tạo Explosion ngay điểm va chạm
				createFinalExplosion(hitPosition)

				-- Đổi hướng ngang random
				orbitFinalVelocity =
					getRandomHorizontalDirection() * 20

				-- Đẩy nhẹ khỏi bề mặt để tránh raycast
				-- trúng lại cùng một điểm ở frame kế tiếp.
				orbitFinalPart.Position +=
					orbitFinalVelocity.Unit * 0.05

