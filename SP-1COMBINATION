local function startSplitBoost()
	if destroyed or deathTweenStarted then
		return
	end

	local info = TweenInfo.new(
		2,
		Enum.EasingStyle.Sine,
		Enum.EasingDirection.In
	)

	local startSpotlightSpeed = spotlightSpeed
	local targetSpotlightSpeed = startSpotlightSpeed * 30

	for _, obj in ipairs(model:GetDescendants()) do
		if obj:IsA("Sound") then
			tweenProperty(
				obj,
				info,
				{
					Volume = 10,
					PlaybackSpeed = 2
				}
			)

		elseif obj:IsA("PointLight") then
			tweenProperty(
				obj,
				info,
				{
					Brightness = 10,
					Range = 25
				}
			)
		end
	end

	task.spawn(function()
		local elapsed = 0

		while elapsed < 2
			and not destroyed
			and not deathTweenStarted do

			local dt = RunService.RenderStepped:Wait()
			elapsed += dt

			local a =
				math.clamp(elapsed / 2, 0, 1)

			a = TweenService:GetValue(
				a,
				Enum.EasingStyle.Sine,
				Enum.EasingDirection.In
			)

			shakeStrength =
				baseShakeStrength +
				(0.25 - baseShakeStrength) * a

			rotationStrength =
				baseRotationStrength +
				(18 - baseRotationStrength) * a

			spotlightSpeed =
				startSpotlightSpeed +
				(targetSpotlightSpeed - startSpotlightSpeed) * a
		end

		if not destroyed and not deathTweenStarted then
			spotlightSpeed = targetSpotlightSpeed
		end
	end)
end

local function fadeTrail(trail)
	if not trail or not trail.Parent then
		return
	end

	local original = trail.Transparency
	local elapsed = 0

	task.spawn(function()
		while elapsed < 4
			and trail
			and trail.Parent
			and not destroyed do

			local dt = RunService.RenderStepped:Wait()
			elapsed += dt

			local a = math.clamp(elapsed / 4, 0, 1)

			a = TweenService:GetValue(
				a,
				Enum.EasingStyle.Sine,
				Enum.EasingDirection.Out
			)

			local points = {}

			for _, keypoint in ipairs(original.Keypoints) do
				points[#points + 1] = NumberSequenceKeypoint.new(
					keypoint.Time,
					keypoint.Value + (1 - keypoint.Value) * a,
					keypoint.Envelope
				)
			end

			trail.Transparency = NumberSequence.new(points)
		end

		if trail and trail.Parent then
			trail.Transparency = NumberSequence.new(1)
			trail.Enabled = false
		end
	end)
end

local function tweenBeamToBlack()
	local beam = splitBeam

	if not beam
		or not beam.Parent
		or not beam:IsA("Beam") then
		return
	end

	local elapsed = 0

	local startColors = {
		Color3.fromRGB(255, 66, 66),
		Color3.fromRGB(66, 214, 255)
	}

	task.spawn(function()
		while elapsed < 4
			and beam
			and beam.Parent
			and not destroyed do

			local dt = RunService.RenderStepped:Wait()
			elapsed += dt

			local a =
				math.clamp(elapsed / 4, 0, 1)

			a = TweenService:GetValue(
				a,
				Enum.EasingStyle.Sine,
				Enum.EasingDirection.Out
			)

			local red =
				startColors[1]:Lerp(
					Color3.new(0, 0, 0),
					a
				)

			local blue =
				startColors[2]:Lerp(
					Color3.new(0, 0, 0),
					a
				)

			if beam
				and beam.Parent
				and beam:IsA("Beam") then

				beam.Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, red),
					ColorSequenceKeypoint.new(0.5, red),
					ColorSequenceKeypoint.new(0.5001, blue),
					ColorSequenceKeypoint.new(1, blue)
				})

				beam.Enabled = true
			else
				break
			end
		end

		if beam
			and beam.Parent
			and beam:IsA("Beam") then

			beam.Color = ColorSequence.new(
				Color3.new(0, 0, 0)
			)

			beam.Enabled = true
		end
	end)
end

