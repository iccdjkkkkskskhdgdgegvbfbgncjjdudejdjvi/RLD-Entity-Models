local outOfRangeTriggered = false

local function fadeParticleEmitter(emitter, duration)
	local startSequence = emitter.Transparency

	local driver = Instance.new("NumberValue")
	driver.Value = 0

	local connection

	connection = driver:GetPropertyChangedSignal("Value"):Connect(function()
		if not emitter or not emitter.Parent then
			if connection then
				connection:Disconnect()
			end
			driver:Destroy()
			return
		end

		local alpha = driver.Value
		local keypoints = {}

		for _, keypoint in ipairs(startSequence.Keypoints) do
			table.insert(
				keypoints,
				NumberSequenceKeypoint.new(
					keypoint.Time,
					keypoint.Value + (1 - keypoint.Value) * alpha,
					keypoint.Envelope
				)
			)
		end

		emitter.Transparency = NumberSequence.new(keypoints)
	end)

	local tween = TweenService:Create(
		driver,
		TweenInfo.new(
			duration,
			Enum.EasingStyle.Linear,
			Enum.EasingDirection.Out
		),
		{
			Value = 1
		}
	)

	tween.Completed:Connect(function()
		if connection then
			connection:Disconnect()
		end

		if emitter and emitter.Parent then
			emitter.Transparency = NumberSequence.new(1)
		end

		driver:Destroy()
	end)

	tween:Play()

	return tween
end

